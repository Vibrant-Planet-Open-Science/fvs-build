# FVSOnLocal (fvsOL) GUI container image -- Binder-ready.
# Build contract and context layout: docs/workflow-interface.md. Usage: README.
#
# Copies the FVS<v>.so set from a prior native build and builds only the pure-R
# glue layer (rFVS + fvsOL) here; FVS is never compiled in Docker.
#
# Base image choice of rocker/r2u:noble has two reasons: it is glibc-identical
# to the ubuntu-24.04 native runner, so the copied .so load cleanly, and
# r2u+bspm make install.packages() pull signed apt binaries with system deps
# resolved.
#
# No ENTRYPOINT on purpose: JupyterHub supplies the command.

FROM rocker/r2u:noble

# Provenance ARGs mirror Dockerfile.runtime (derived from the bundle's
# manifest.json by the workflow), extended with the Interface source provenance.
# Kept as ARGs so ad-hoc local builds can pass --build-arg.
ARG SOURCE_REPO
ARG SOURCE_REF
ARG SOURCE_SHA
ARG FVS_BUILD_REPO
ARG FVS_BUILD_REF
ARG FVS_BUILD_SHA
ARG VARIANTS
ARG GFORTRAN_VERSION
ARG MESON_VERSION
ARG TIMESTAMP
ARG INTERFACE_REPO
ARG INTERFACE_REF
ARG INTERFACE_SHA

ENV DEBIAN_FRONTEND=noninteractive
ENV FVS_VERSION=${SOURCE_REF}
# Binder identity. Jupyter and the app run as this unprivileged user.
ENV USER=jovyan
ENV HOME=/home/jovyan
# Python venv holding the Binder/Jupyter stack, on PATH for every user so
# `jupyter` resolves without --break-system-packages against noble's PEP 668
# externally-managed system Python.
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:${PATH}
# rgl runs headless in the container/Binder: use its null device instead of
# trying (and failing) to open an X11/OpenGL display.
ENV RGL_USE_NULL=TRUE

# FVS runtime libraries r2u will NOT pull (they satisfy the copied FVS<v>.so's
# Fortran/quad-precision runtime), plus build glue: make/git for the R package
# data-gen makefiles, python3-venv for the Jupyter venv, ca-certificates.
RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && apt-get install -y --no-install-recommends \
  libgfortran5 \
  libquadmath0 \
  make \
  git \
  python3-venv \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Binder stack. notebook>=7 is the jupyter-server-backed line (avoid classic 6).
#
# jupyterhub is REQUIRED: BinderHub spawns `jupyterhub-singleuser`, not
# `jupyter lab`. Without it every /user/<id>/ path 404s while the image still
# runs fine standalone. smoke check 6.
RUN python3 -m venv "${VIRTUAL_ENV}" \
  && pip install --no-cache-dir \
  "notebook>=7" \
  jupyterlab \
  jupyter-server-proxy \
  jupyterhub

# fvsOL/rFVS build + runtime R dependencies. devtools/roxygen2/remotes are here
# because neither package ships NAMESPACE/man, so document() must run before
# install().
RUN Rscript -e 'pkgs <- c( \
  "devtools", "roxygen2", "remotes", \
  "shiny", "Cairo", "rhandsontable", "ggplot2", "RSQLite", "plyr", "dplyr", \
  "colourpicker", "rgl", "leaflet", "zip", "openxlsx", "shinyFiles"); \
  install.packages(pkgs); \
  missing <- setdiff(pkgs, rownames(installed.packages())); \
  if (length(missing)) { message("failed to install: ", paste(missing, collapse = ", ")); quit(status = 1) }'

# rFVS::fvsLoad() globs FVS*.so here to auto-discover variants. The glob is also
# the guard: matching nothing fails the build rather than shipping an empty image.
COPY bundle/FVS*.so /opt/fvs/FVSbin/

# Provenance manifest + binary SBOM, mirroring Dockerfile.runtime's layout.
COPY bundle/provenance/manifest.json         /usr/share/fvs-build/manifest.json
COPY bundle/sbom/fvs-native-linux.spdx.json  /usr/share/fvs-build/sbom-binaries.spdx.json

# rFVS + fvsOL sources, staged by the workflow as siblings (the fvsOL data-gen
# scripts and devtools calls assume the sibling layout).
COPY fvs-gui-context/rFVS/  /opt/fvs/interface/rFVS/
COPY fvs-gui-context/fvsOL/ /opt/fvs/interface/fvsOL/

# Guard: sources predating upstream PR #29 use dbWriteTable(DBI::SQL("temp.X")),
# which breaks on RSQLite >= 3.53.1 and greys out the app on stand selection --
# an image that builds fine and fails in the UI. The release tag FS2026.2
# predates the fix, so this stays until no supported interface_ref can.
WORKDIR /opt/fvs/interface
RUN if grep -rq 'DBI::SQL("temp' fvsOL/R; then \
  echo "ERROR: interface source predates the RSQLite temp-table fix (PR #29)." >&2; \
  echo "       Use an interface_ref at or after upstream main 92dc046." >&2; \
  exit 1; \
  fi

# Patches applied BEFORE the package is built so the installed copy carries
# them. The image runs fvsOL in LOCAL mode (see the proxy config), which is the
# mode that wires up the working-directory chooser, the project backup upload
# and project switching -- but upstream Local mode has two Linux/reverse-proxy
# defects that make it unusable as shipped.
COPY docker/fvs-gui/patches/ /opt/fvs/patches/
RUN git apply --verbose /opt/fvs/patches/*.patch

# Assert the patch actually took, in the shape of the DBI::SQL guard above: an
# origin-absolute stand-image URL and the mis-cased lock-file removal are both
# invisible at build time and only surface in a live session.
RUN if grep -rq '"/www/s' fvsOL/R; then \
  echo "ERROR: origin-absolute /www/ stand-image URL still present in fvsOL/R." >&2; \
  echo "       View On Maps popup graphs will 404 under the /fvs-gui/ subpath." >&2; \
  exit 1; \
  fi \
  && if grep -rq 'ProjectIsLocked' fvsOL/R; then \
  echo "ERROR: mis-cased ProjectIsLocked.txt still present in fvsOL/R." >&2; \
  echo "       Leaving a project would strand a lock and hide it from the picker." >&2; \
  exit 1; \
  fi

# Build the R glue layer in dependency order. The mkpkeys/mkhelp step generates
# prms.RData and fvsOnlineHelpRender.RData, which fvsOL does not ship, and must
# run with cwd = the fvsOL package dir.
WORKDIR /opt/fvs/interface
RUN Rscript -e 'devtools::document("rFVS"); devtools::install("rFVS", dependencies = FALSE, upgrade = FALSE)'
WORKDIR /opt/fvs/interface/fvsOL
RUN Rscript parms/mkpkeys.R \
  && Rscript inst/extdata/mkhelp.R
WORKDIR /opt/fvs/interface
RUN Rscript -e 'devtools::document("fvsOL"); devtools::install("fvsOL", dependencies = FALSE, upgrade = FALSE)' \
  && Rscript -e 'stopifnot(requireNamespace("fvsOL", quietly = TRUE), requireNamespace("rFVS", quietly = TRUE))'

# Silence bspm's D-Bus warning on every runtime R session (no package daemon in
# a headless container). Must be set before r2u's Rprofile.site calls
# bspm::enable(), hence the prepend. The sudo backend is never actually invoked.
RUN R_SITE="$(R RHOME)/etc/Rprofile.site" \
  && touch "$R_SITE" \
  && { echo 'options(bspm.sudo = TRUE)'; cat "$R_SITE"; } > "${R_SITE}.tmp" \
  && mv "${R_SITE}.tmp" "$R_SITE"

# The /fvs-gui/ route is registered by an entry point, NOT a Jupyter config
# file -- mybinder mounts a ConfigMap over /etc/jupyter at runtime and would
# mask one. Full rationale in the package's module docstring. smoke checks 7, 8.
#
# jupyter-server-proxy warn()s and skips an entry point that raises, so a
# mistake here would allow a silent 404 rather than a startup error. Fail the
# build instead.
COPY docker/fvs-gui/launch.R              /opt/fvs/launch.R
COPY docker/fvs-gui/jupyter-fvsol-proxy/  /opt/fvs/jupyter-fvsol-proxy/
RUN pip install --no-cache-dir /opt/fvs/jupyter-fvsol-proxy \
  && python -c 'import os; \
from importlib.metadata import entry_points; \
from jupyter_server_proxy.config import ServerProcess; \
eps = {e.name: e for e in entry_points(group="jupyter_serverproxy_servers")}; \
assert "fvs-gui" in eps, "fvs-gui entry point is not registered"; \
sp = ServerProcess(name="fvs-gui", **eps["fvs-gui"].load()()); \
assert os.path.exists(sp.command[1]), "launch shim missing: " + sp.command[1]; \
assert os.path.exists(sp.launcher_entry.icon_path), "launcher icon missing"'

# Binder requires uid 1000, and the app writes runs/SQLite/www into prjDir, so
# prjDir and HOME must be writable by it. Noble already ships an `ubuntu` user
# at uid 1000, hence the userdel before useradd.
RUN if id -u 1000 >/dev/null 2>&1; then \
  userdel -r "$(id -un 1000)" 2>/dev/null || userdel "$(id -un 1000)"; \
  fi \
  && useradd --create-home --uid 1000 --shell /bin/bash jovyan \
  && mkdir -p /home/jovyan/project \
  && chown -R 1000:1000 /home/jovyan /opt/fvs

# OCI standard provenance labels.
LABEL org.opencontainers.image.source="https://github.com/${FVS_BUILD_REPO}" \
  org.opencontainers.image.revision="${FVS_BUILD_SHA}" \
  org.opencontainers.image.version="${SOURCE_REF}" \
  org.opencontainers.image.created="${TIMESTAMP}" \
  org.opencontainers.image.title="usfs-fvs-gui" \
  org.opencontainers.image.description="FVSOnLocal (fvsOL) R-Shiny GUI over FVS variant shared libraries, packaged Binder-ready on rocker/r2u:noble. FVS .so copied from a native build (never compiled in Docker); only the rFVS/fvsOL R layer is built here. Built by Vibrant-Planet-Open-Science/fvs-build." \
  org.opencontainers.image.documentation="https://github.com/${FVS_BUILD_REPO}/blob/${FVS_BUILD_REF}/docs/workflow-interface.md"

# fvs-build-specific provenance: FVS source, toolchain, variant set (all from
# the native bundle) plus the Interface source the R layer was built from.
LABEL org.vibrantplanet.fvs.source-repo="${SOURCE_REPO}" \
  org.vibrantplanet.fvs.source-ref="${SOURCE_REF}" \
  org.vibrantplanet.fvs.source-sha="${SOURCE_SHA}" \
  org.vibrantplanet.fvs.fvs-build-repo="${FVS_BUILD_REPO}" \
  org.vibrantplanet.fvs.fvs-build-ref="${FVS_BUILD_REF}" \
  org.vibrantplanet.fvs.fvs-build-sha="${FVS_BUILD_SHA}" \
  org.vibrantplanet.fvs.variants="${VARIANTS}" \
  org.vibrantplanet.fvs.gfortran-version="${GFORTRAN_VERSION}" \
  org.vibrantplanet.fvs.meson-version="${MESON_VERSION}" \
  org.vibrantplanet.fvs.interface-repo="${INTERFACE_REPO}" \
  org.vibrantplanet.fvs.interface-ref="${INTERFACE_REF}" \
  org.vibrantplanet.fvs.interface-sha="${INTERFACE_SHA}"

WORKDIR /home/jovyan
# Numeric on purpose (hadolint DL3066): this is the jovyan account created
# above, and Binder requires the image to run as uid 1000.
USER 1000
