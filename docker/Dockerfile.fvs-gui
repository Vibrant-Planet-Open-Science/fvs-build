# FVSOnLocal (fvsOL) GUI container image -- Binder-ready.
# Build contract and context layout: docs/fvs-gui-container.md. Usage: README.
#
# Copies the FVS<v> executables and FVS<v>.so set from a prior native build and
# builds only the pure-R glue layer (rFVS + fvsOL) here; FVS is never compiled
# in Docker.
#
# rocker/r2u:noble: r2u+bspm make install.packages() pull apt binaries with
# system deps resolved.
#
# No ENTRYPOINT on purpose: JupyterHub supplies the command.

FROM rocker/r2u:noble

ARG SOURCE_REPO
ARG SOURCE_REF
ARG SOURCE_SHA
ARG FVS_BUILD_REPO
ARG FVS_BUILD_REF
ARG FVS_BUILD_SHA
ARG VARIANTS
ARG GFORTRAN_VERSION
ARG MESON_VERSION
ARG TIMESTAMP
ARG INTERFACE_REPO
ARG INTERFACE_REF
ARG INTERFACE_SHA

ENV DEBIAN_FRONTEND=noninteractive
ENV FVS_VERSION=${SOURCE_REF}
ENV USER=jovyan
ENV HOME=/home/jovyan
# Venv for the Jupyter stack: noble's system Python is PEP 668 externally managed.
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:${PATH}
# Headless: no X11/OpenGL display for rgl.
ENV RGL_USE_NULL=TRUE
# Where the FVS<v>.so set lives, for notebooks: rFVS::fvsLoad(bin = ...) and
# fvs2py.FVS(<path to .so>).
ENV FVS_BIN=/opt/fvs/FVSbin

# make/git for the R package data-gen makefiles. libgfortran5, which the
# FVS<v>.so libraries need, already comes with R's LAPACK in the base image.
RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && apt-get install -y --no-install-recommends \
  make \
  git \
  python3-venv \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# jupyterhub is REQUIRED: BinderHub spawns `jupyterhub-singleuser`. Without it
# every /user/<id>/ path 404s while the image still runs fine standalone.
# fvs2py is pinned: notebooks are written against its API.
RUN python3 -m venv "${VIRTUAL_ENV}" \
  && pip install --no-cache-dir \
  "notebook>=7" \
  jupyterlab \
  jupyter-server-proxy \
  jupyterhub \
  "fvs2py==0.2.1"

# rFVS::fvsLoad() globs FVS*.so here. A COPY glob matching nothing fails the build.
COPY bundle/FVS*.so /opt/fvs/FVSbin/
# The executables, for running FVS from the command line. Variant codes are two
# letters, so FVS?? takes them and not the .so files.
COPY --chmod=755 bundle/FVS?? /usr/local/bin/

COPY bundle/provenance/manifest.json         /usr/share/fvs-build/manifest.json
COPY bundle/sbom/fvs-native-linux.spdx.json  /usr/share/fvs-build/sbom-binaries.spdx.json

# The fvsOL data-gen scripts assume rFVS is a sibling.
COPY fvs-gui-context/rFVS/  /opt/fvs/interface/rFVS/
COPY fvs-gui-context/fvsOL/ /opt/fvs/interface/fvsOL/

# rFVS and fvsOL ship NAMESPACE and man/ from Interface release 20261019;
# older refs would install packages with no NAMESPACE.
WORKDIR /opt/fvs/interface
RUN for p in rFVS fvsOL; do \
  if [ ! -f "$p/NAMESPACE" ]; then \
  echo "ERROR: $p has no NAMESPACE; use an interface_ref at or after 20261019." >&2; \
  exit 1; \
  fi; \
  done

# fvsOL's Depends + Imports, as r2u binaries.
RUN Rscript -e 'd <- read.dcf("fvsOL/DESCRIPTION", c("Depends", "Imports")); \
  pkgs <- trimws(sub("[(].*", "", unlist(strsplit(d[!is.na(d)], ",")))); \
  pkgs <- setdiff(pkgs[nzchar(pkgs)], c("R", "rFVS", rownames(installed.packages(priority = "base")))); \
  install.packages(pkgs); \
  missing <- setdiff(pkgs, rownames(installed.packages())); \
  if (length(missing)) { message("failed to install: ", paste(missing, collapse = ", ")); quit(status = 1) }'

# R kernel for Jupyter, registered system-wide next to the venv's python3.
RUN Rscript -e 'install.packages("IRkernel"); IRkernel::installspec(user = FALSE)'

# fvsOL runs in Local mode (working-directory chooser, backup upload, project
# switching), which upstream breaks on Linux behind a reverse proxy.
COPY docker/fvs-gui/patches/ /opt/fvs/patches/
RUN git apply --verbose /opt/fvs/patches/*.patch

# Both defects only surface in a live session, so assert the patch took.
RUN if grep -rq '"/www/s' fvsOL/R; then \
  echo "ERROR: origin-absolute /www/ stand-image URL still present in fvsOL/R." >&2; \
  echo "       View On Maps popup graphs will 404 under the /fvs-gui/ subpath." >&2; \
  exit 1; \
  fi \
  && if grep -rq 'ProjectIsLocked' fvsOL/R; then \
  echo "ERROR: mis-cased ProjectIsLocked.txt still present in fvsOL/R." >&2; \
  echo "       Leaving a project would strand a lock and hide it from the picker." >&2; \
  exit 1; \
  fi

# mkpkeys/mkhelp generate prms.RData and fvsOnlineHelpRender.RData, which fvsOL
# does not ship; they must run from the fvsOL dir.
WORKDIR /opt/fvs/interface
RUN R CMD INSTALL rFVS
WORKDIR /opt/fvs/interface/fvsOL
RUN Rscript parms/mkpkeys.R \
  && Rscript inst/extdata/mkhelp.R
WORKDIR /opt/fvs/interface
RUN R CMD INSTALL fvsOL \
  && Rscript -e 'stopifnot(requireNamespace("fvsOL", quietly = TRUE), requireNamespace("rFVS", quietly = TRUE))'

# Silences bspm's D-Bus warning in every R session. Prepended: it must precede
# r2u's bspm::enable(). The sudo backend is never invoked.
RUN R_SITE="$(R RHOME)/etc/Rprofile.site" \
  && touch "$R_SITE" \
  && { echo 'options(bspm.sudo = TRUE)'; cat "$R_SITE"; } > "${R_SITE}.tmp" \
  && mv "${R_SITE}.tmp" "$R_SITE"

# /fvs-gui/ is registered by an entry point, not a Jupyter config file: mybinder
# mounts a ConfigMap over /etc/jupyter. jupyter-server-proxy skips an entry point
# that raises (a silent 404), so check it at build time.
COPY docker/fvs-gui/launch.R              /opt/fvs/launch.R
COPY docker/fvs-gui/jupyter-fvsol-proxy/  /opt/fvs/jupyter-fvsol-proxy/
RUN pip install --no-cache-dir /opt/fvs/jupyter-fvsol-proxy \
  && python -c 'import os; \
from importlib.metadata import entry_points; \
from jupyter_server_proxy.config import ServerProcess; \
eps = {e.name: e for e in entry_points(group="jupyter_serverproxy_servers")}; \
assert "fvs-gui" in eps, "fvs-gui entry point is not registered"; \
sp = ServerProcess(name="fvs-gui", **eps["fvs-gui"].load()()); \
assert os.path.exists(sp.command[1]), "launch shim missing: " + sp.command[1]; \
assert os.path.exists(sp.launcher_entry.icon_path), "launcher icon missing"'

# Binder requires uid 1000, which must own prjDir and HOME. Noble's `ubuntu`
# user already holds uid 1000.
RUN if id -u 1000 >/dev/null 2>&1; then \
  userdel -r "$(id -un 1000)" 2>/dev/null || userdel "$(id -un 1000)"; \
  fi \
  && useradd --create-home --uid 1000 --shell /bin/bash jovyan \
  && mkdir -p /home/jovyan/project \
  && chown -R 1000:1000 /home/jovyan /opt/fvs

# `licenses` covers what fvs-build puts in the image: FVS, NVEL and rFVS/fvsOL
# (CC0-1.0), SQLite (blessing), the GCC runtime linked into the executables,
# and fvs-build (MIT). R, Jupyter and system packages are in the image SBOM.
LABEL org.opencontainers.image.source="https://github.com/${FVS_BUILD_REPO}" \
  org.opencontainers.image.revision="${FVS_BUILD_SHA}" \
  org.opencontainers.image.version="${SOURCE_REF}" \
  org.opencontainers.image.created="${TIMESTAMP}" \
  org.opencontainers.image.title="usfs-fvs-gui" \
  org.opencontainers.image.description="FVSOnLocal (fvsOL) R-Shiny GUI over FVS variant shared libraries, plus the FVS variant executables and Jupyter R and Python kernels with rFVS and fvs2py, packaged Binder-ready on rocker/r2u:noble. FVS binaries copied from a native build (never compiled in Docker); only the rFVS/fvsOL R layer is built here. Built by Vibrant-Planet-Open-Science/fvs-build." \
  org.opencontainers.image.licenses="MIT AND CC0-1.0 AND blessing AND GPL-3.0-or-later WITH GCC-exception-3.1 AND LGPL-2.1-or-later" \
  org.opencontainers.image.documentation="https://github.com/${FVS_BUILD_REPO}/blob/${FVS_BUILD_REF}/docs/fvs-gui-container.md"

LABEL org.vibrantplanet.fvs.source-repo="${SOURCE_REPO}" \
  org.vibrantplanet.fvs.source-ref="${SOURCE_REF}" \
  org.vibrantplanet.fvs.source-sha="${SOURCE_SHA}" \
  org.vibrantplanet.fvs.fvs-build-repo="${FVS_BUILD_REPO}" \
  org.vibrantplanet.fvs.fvs-build-ref="${FVS_BUILD_REF}" \
  org.vibrantplanet.fvs.fvs-build-sha="${FVS_BUILD_SHA}" \
  org.vibrantplanet.fvs.variants="${VARIANTS}" \
  org.vibrantplanet.fvs.gfortran-version="${GFORTRAN_VERSION}" \
  org.vibrantplanet.fvs.meson-version="${MESON_VERSION}" \
  org.vibrantplanet.fvs.interface-repo="${INTERFACE_REPO}" \
  org.vibrantplanet.fvs.interface-ref="${INTERFACE_REF}" \
  org.vibrantplanet.fvs.interface-sha="${INTERFACE_SHA}"

WORKDIR /home/jovyan
USER 1000
