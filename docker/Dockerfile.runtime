# Runtime-only image for FVS binaries built by build-native-linux.yml; nothing is
# compiled here. The binaries come from manylinux_2_28, so any base with glibc
# 2.28 or newer and libgfortran5 works.

ARG RUNTIME_BASE=ubuntu:24.04
FROM ${RUNTIME_BASE}

ARG SOURCE_REPO
ARG SOURCE_REF
ARG SOURCE_SHA
ARG FVS_BUILD_REPO
ARG FVS_BUILD_REF
ARG FVS_BUILD_SHA
ARG VARIANTS
ARG GFORTRAN_VERSION
ARG MESON_VERSION
ARG TIMESTAMP

ENV DEBIAN_FRONTEND=noninteractive
ENV FVS_VERSION=${SOURCE_REF}

# The executables link the GCC runtime statically; the FVS<v>.so libraries need
# libgfortran5. No libquadmath0: GCC 13+ libgfortran uses glibc's _Float128.
RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && apt-get install -y --no-install-recommends \
  libgfortran5 \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY bundle/ /opt/fvs-bundle/
RUN set -eux; \
  for f in /opt/fvs-bundle/FVS*; do \
  case "$f" in \
  *.so) install -D -m 644 "$f" "/usr/local/lib/$(basename "$f")" ;; \
  *) install -D -m 755 "$f" "/usr/local/bin/$(basename "$f")" ;; \
  esac; \
  done

COPY bundle/provenance/manifest.json         /usr/share/fvs-build/manifest.json
COPY bundle/sbom/fvs-native.spdx.json  /usr/share/fvs-build/sbom-binaries.spdx.json

RUN chmod +x /usr/local/bin/FVS* \
  && ldconfig

# `licenses` covers what fvs-build puts in the image: FVS and NVEL (CC0-1.0),
# SQLite (blessing), the GCC runtime linked into the executables, and fvs-build
# (MIT). Ubuntu's packages are in the image SBOM.
LABEL org.opencontainers.image.source="https://github.com/${FVS_BUILD_REPO}" \
  org.opencontainers.image.revision="${FVS_BUILD_SHA}" \
  org.opencontainers.image.version="${SOURCE_REF}" \
  org.opencontainers.image.created="${TIMESTAMP}" \
  org.opencontainers.image.title="usfs-fvs" \
  org.opencontainers.image.description="Forest Vegetation Simulator (FVS) variant binaries packaged into a runtime-only Ubuntu 24.04 image. Built by Vibrant-Planet-Open-Science/fvs-build. Independent build; not affiliated with or endorsed by the USDA Forest Service." \
  org.opencontainers.image.licenses="MIT AND CC0-1.0 AND blessing AND GPL-3.0-or-later WITH GCC-exception-3.1 AND LGPL-2.1-or-later" \
  org.opencontainers.image.documentation="https://github.com/${FVS_BUILD_REPO}/blob/${FVS_BUILD_REF}/docs/workflow-interface.md"

# OCI source/revision point at fvs-build; these carry the FVS source.
LABEL org.vibrantplanet.fvs.source-repo="${SOURCE_REPO}" \
  org.vibrantplanet.fvs.source-ref="${SOURCE_REF}" \
  org.vibrantplanet.fvs.source-sha="${SOURCE_SHA}" \
  org.vibrantplanet.fvs.fvs-build-repo="${FVS_BUILD_REPO}" \
  org.vibrantplanet.fvs.fvs-build-ref="${FVS_BUILD_REF}" \
  org.vibrantplanet.fvs.fvs-build-sha="${FVS_BUILD_SHA}" \
  org.vibrantplanet.fvs.variants="${VARIANTS}" \
  org.vibrantplanet.fvs.gfortran-version="${GFORTRAN_VERSION}" \
  org.vibrantplanet.fvs.meson-version="${MESON_VERSION}"

# No ENTRYPOINT: docker run --rm -v $PWD:/data IMAGE FVSak --keywordfile=my.key
VOLUME ["/data"]
WORKDIR /data
