# Meson build directories. The conventional name documented in README.md
# is `builddir/`; other names (build-debug/, builddir-release/, etc.) are
# accepted but should be ignored too. The plain `build/` entry above
# already catches one common name.
builddir/
builddir-*/
build-*/

# Local test output
/tmp/fvs-test-output/

# gfortran I/O artifacts: FVS reads keyword input from unit 15 and writes
# summary output to unit 16; if either is exercised without an explicit
# OPEN, gfortran creates fort.<unit> in the current working directory.
# Running ./builddir/FVSpn from this repo root for a smoke test will
# scatter fort.15 / fort.16 here. Always benign, never something to commit.
fort.*
